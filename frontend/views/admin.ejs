<!DOCTYPE html>
<html lang="fr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cité De Soin Et Beauté</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="shortcut icon" href="/img/icon.jpg" type="image/x-icon">
</head>

<body>
    <div id="loader">
        <div id="spinner"></div>
    </div>

    <div id="everything">
        <%- include("includes/adtopbar") %>
            <main>
                <div class="centerpart">
                    <%if(typeof isAdmin==="undefined" || !isAdmin) { %>
                        <div class="loginc">
                            <% if (typeof errors !=="undefined" ) {%>
                                <% if (errors && errors.length) { %>
                                    <% errors.forEach(err=> { %>
                                        <h3 style="color: rgb(182, 2, 2); padding-top: 60px;">
                                            <%= err %>
                                        </h3>
                                        <% }) %>
                                            <% } %>
                                                <% } %>

                                                    <div class="abox">
                                                        <%if(typeof isLimited==="undefined" || !isLimited) { %>
                                                            <form action="/Ad/Login" method="post">
                                                                <h2>Connection</h2>
                                                                <div class="itemlog">
                                                                    <input class="inputt" type="password"
                                                                        name="password" id="password"
                                                                        placeholder="Mot de passe">
                                                                </div>
                                                                <div class="itemlog">
                                                                    <div class="btnitem">
                                                                        <button type="submit">Se Connecter</button>
                                                                    </div>
                                                                </div>
                                                            </form>
                                                            <% } else { %>
                                                                <h2>Connection</h2>
                                                                <div class="itemlog">
                                                                    <input class="inputt" type="password"
                                                                        name="password" id="password"
                                                                        placeholder="Mot de passe" disabled>
                                                                </div>
                                                                <% } %>
                                                    </div>
                        </div>
                        <% } else {%>
                            <p>Welcome Admin</p>
                            <% } %>
                </div>
            </main>

            <%- include("includes/adfooter") %>
    </div>

    <script>
        window.addEventListener("load", () => {
            document.getElementById("loader").classList.add("hide");
            document.getElementById("everything").classList.add("show");
            document.querySelectorAll(".inputt").forEach(element => {
                element.classList.add("click")
            });
        });
    </script>
</body>

</html>