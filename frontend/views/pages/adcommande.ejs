    <title>Cité De Soin Et Beauté</title>
    <link rel="stylesheet" href="/css/main.css">
    <link rel="stylesheet" href="/css/admin.css">
    <link rel="shortcut icon" href="/img/icon.jpg" type="image/x-icon">
